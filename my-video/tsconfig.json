{
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "target": "ES2022",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react",
    "outDir": "./out"
  },
  "include": ["src/**/*"]
}
